OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low prioritizes latency; compare medium/high after the first measured run.
OPENAI_IMAGE_QUALITY=low

# Persistent POC 03. Run settings are captured at creation; restart after edits.
LUNATOON_DATA_DIR=./data
LUNATOON_MAX_STEPS=2
LUNATOON_MAX_IMAGE_CALLS=6
LUNATOON_MAX_SCRIPT_CALLS=3
# Application estimate guard, not an absolute provider billing cap.
LUNATOON_RUN_BUDGET_USD=0.30
